{
  "extends": "@react-native/typescript-config",
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "eslint.config.js",
    "index.js",
    "react-native.config.js",
    "ReactotronConfig.js",
    "scripts/**/*",
    "src/**/*"
  ],
  "exclude": ["**/node_modules", "**/Pods"],
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["bun-types", "jest"],
    "paths": {
      "*": ["./src/*"]
    },
    "verbatimModuleSyntax": true
  }
}
